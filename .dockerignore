# ===========================================
# DOCKERIGNORE OPTIMISÉ POUR COOLIFY/NIXPACKS
# Réduit le contexte Docker de 280Mo à ~50Mo
# ===========================================

# Dépendances Node.js (CRITIQUE - le plus gros)
node_modules
.npm
.yarn
.pnpm-store
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Fichiers de build et cache Nuxt (reconstruits pendant le build)
.nuxt
.output
.nitro
dist
.cache

# Fichiers d'environnement
.env
.env.*
!.env.example

# IDE et éditeurs
.vscode
.idea
*.swp
*.swo
*~
.editorconfig

# Git (IMPORTANT - peut être très volumineux)
.git
.gitignore
.gitattributes
.github
.gitmodules

# Tests (pas nécessaires en production)
test
tests
__tests__
*.test.ts
*.test.js
*.spec.ts
*.spec.js
coverage
.nyc_output
test-results
.playwright
vitest.config.*

# Documentation
README.md
CHANGELOG.md
CLAUDE.md
CONTRIBUTING.md
LICENSE
docs/

# Fichiers de développement Docker
Dockerfile.dev
docker-compose*.yml
!docker-compose.yml

# Fichiers de logs
logs
*.log

# Fichiers temporaires
.tmp
tmp
temp
*.tmp

# Fichiers de cache dev
.eslintcache
.stylelintcache
.prettiercache
tsconfig.tsbuildinfo

# Fichiers de backup
*.backup
*.bak
*.orig

# Fichiers système
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Assets non nécessaires au build
*.psd
*.ai
*.sketch

# Scripts de développement local
scripts/
locust/

# Fichiers Locust (tests de charge)
test/
