{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run copy-pdf-worker && nuxt build",
    "dev": "npm run copy-pdf-worker && nuxt dev",
    "start": "node .output/server/index.mjs",
    "generate": "npm run copy-pdf-worker && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run copy-pdf-worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "copy-pdf-worker": "mkdir -p public/pdf-worker && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf-worker/"
  },
  "dependencies": {
    "@ai-sdk/vue": "^1.2.9",
    "@directus/sdk": "^19.1.0",
    "@nuxt/content": "^2.13.2",
    "@nuxt/eslint": "^0.5.4",
    "@nuxt/image": "^1.7.0",
    "@nuxt/ui": "2.18.3",
    "@nuxtjs/leaflet": "^1.2.4",
    "@nuxtjs/mdc": "^0.17.0",
    "@nuxtjs/seo": "^2.0.2",
    "@nuxtjs/web-vitals": "^0.2.7",
    "@pinia/nuxt": "^0.5.4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/marked": "^5.0.2",
    "@vite-pwa/nuxt": "^1.0.0",
    "@vueuse/motion": "^2.2.3",
    "@vueuse/nuxt": "^13.1.0",
    "d3": "^7.9.0",
    "marked": "^15.0.8",
    "nuxt": "3.14.1592",
    "nuxt-security": "^2.2.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.3.93",
    "pinia": "^2.2.2",
    "reka-ui": "^2.2.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue-sonner": "^1.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^0.5.4",
    "@types/d3": "^7.4.3",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/geojson": "^7946.0.14",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "execa": "^9.3.0",
    "nuxt-gtag": "^3.0.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6"
  }
}
