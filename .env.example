# ── Site ──────────────────────────────────────────────────────────────────────
NUXT_SITE_ENV=dev
NUXT_PUBLIC_SITE_URL=https://www.vie-publique.sn
NUXT_PUBLIC_APP_ENV=production
PWA_ENABLED=true

# ── CMS Directus ──────────────────────────────────────────────────────────────
# URL sans trailing slash
CMS_API_URL=https://cms.vie-publique.sn
NUXT_CMS_API_KEY=your_directus_api_key

# ── Sentry (monitoring d'erreurs) ─────────────────────────────────────────────
# Vide/absent = Sentry désactivé. Voir docs/infra/sentry.md
NUXT_PUBLIC_SENTRY_DSN=

# ── Analytics ─────────────────────────────────────────────────────────────────
GTAG_ID=G-XXXXXX
FACEBOOK_PIXEL_ID=votre_pixel_id_ici
CLARITY_PROJECT_ID=votre_clarity_project_id

# ── Feature Flags ─────────────────────────────────────────────────────────────
NUXT_FEATURE_FLAGS_ENABLED=true
NUXT_PUBLIC_ENABLE_BETA_FEATURES=false
NUXT_PUBLIC_ENABLE_DEBUG_MENU=false
PUBLIC_SHOW_PINNED_PEOLPLES=false
PUBLIC_SHOW_SCANDALS=false
PUBLIC_SHOW_BAROMETER=false

# ── Typesense Search ──────────────────────────────────────────────────────────
TYPESENSE_URL=https://search.vie-publique.sn
# Clé SEARCH-ONLY scoped (documents:search) — jamais la clé admin dans l'app
TYPESENSE_API_KEY=your_typesense_search_only_key
# Alias Typesense (bascule blue/green sans redéploiement) — docs/search/audit-recherche-2026-07.md
TYPESENSE_COLLECTION=vp-search
# Clé ADMIN — uniquement pour scripts/search-reindex.mjs (réindexation/réconciliation)
TYPESENSE_ADMIN_API_KEY=your_typesense_admin_key

# ── Brevo (Email marketing) ───────────────────────────────────────────────────
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=3

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM_EMAIL=noreply@vie-publique.sn

# ── Bictorys (Paiement) ───────────────────────────────────────────────────────
BICTORYS_API_KEY=test_public-VOTRE_CLE_ICI
BICTORYS_SECRET_KEY=test_secret-VOTRE_CLE_ICI
BICTORYS_API_URL=https://api.test.bictorys.com/pay/v1/charges
BICTORYS_WEBHOOK_SECRET=your_webhook_secret

# ── Sunu Election API ─────────────────────────────────────────────────────────
SUNU_ELECTION_API_URL=https://api-snlegislatives-prd.azurewebsites.net
SUNU_ELECTION_API_KEY=your_sunu_election_api_key

# ── Chatbot (DocIntel) ────────────────────────────────────────────────────────
CHATBOT_API_URL=https://your-chatbot-api.azurewebsites.net
CHATBOT_API_KEY=your_chatbot_api_key

# ── Firebase (Push Notifications) ────────────────────────────────────────────
NUXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NUXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key
# JSON du compte de service Firebase Admin (serveur uniquement)
NUXT_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
